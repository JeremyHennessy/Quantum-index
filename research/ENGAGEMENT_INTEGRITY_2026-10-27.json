      "beforeText": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Quantum Index responsive verification</title><style>body{font:16px system-ui;background:#071018;color:#eef5f7;margin:20px}label{display:inline-block;margin:8px}iframe{display:block;height:844px;border:1px solid #91a6b2;margin-top:12px}select{font:inherit}</style><h1>Responsive verification</h1><p>Fixed-width browser frame. Checks responsive layout; does not emulate iOS Safari or touch hardware.</p><label>Width <select id=\"width\"><option>390</option><option>430</option><option>320</option></select></label><label>Page <select id=\"page\"><option value=\"learn\">Learning paths</option><option value=\"compare?ids=unruh,hawking-radiation\">Comparison</option><option value=\"theory/unruh?from=learn&path=gravity-time\">Theory</option><option value=\"formula?theory=unruh\">Equations</option><option value=\"workspace\">My research</option><option value=\"coverage\">Coverage</option></select></label><iframe title=\"Responsive app preview\" id=\"preview\" width=\"390\" src=\"../index.html?v=6f035f752b7e4573#/learn\"></iframe><script>const frame=document.querySelector('#preview');document.querySelector('#width').onchange=e=>frame.width=e.target.value;document.querySelector('#page').onchange=e=>frame.src='../index.html?v=6f035f752b7e4573#/'+e.target.value;</script></html>\n"
    }
